Date: Mon, 12 Oct 2026 02:52:16 +0500
Subject: [PATCH 2/2] fix(mobile): refresh plan status in Call tab and Parents
 hub after a purchase

The shell stays mounted behind the paywall, so plan state was only read on
mount. App now bumps a billingVersion on purchase and the shell and hub
re-check isPremiumActive when it changes.

Co-Authored-By: Claude Sonnet 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01REAKZC8Lf9sZR4W9koY12Z
---
 mobile/App.tsx                         | 4 ++++
 mobile/src/components/ParentsHub.tsx   | 4 +++-
 mobile/src/screens/MainShellScreen.tsx | 9 +++++++++
 3 files changed, 16 insertions(+), 1 deletion(-)

diff --git a/mobile/App.tsx b/mobile/App.tsx
index 86474eb..eaa3fc6 100644
--- a/mobile/App.tsx
+++ b/mobile/App.tsx
@@ -33,6 +33,8 @@ export default function App() {
   const [screen, setScreen] = useState<Screen>('checking');
   const [activeStudent, setActiveStudent] = useState<Student | null>(null);
   const [gateVisible, setGateVisible] = useState(false);
+  // Bumped after a successful purchase so mounted screens re-check the plan.
+  const [billingVersion, setBillingVersion] = useState(0);
 
   useEffect(() => {
     (async () => {
@@ -101,6 +103,7 @@ export default function App() {
               setScreen('liveVoice');
             }}
             onLimitReached={handleLimitReached}
+            billingVersion={billingVersion}
           />
         </View>
 
@@ -108,6 +111,7 @@ export default function App() {
           <PaywallScreen
             onBack={() => setScreen('main')}
             onPurchased={() => {
+              setBillingVersion((v) => v + 1);
               setScreen('main');
             }}
           />
diff --git a/mobile/src/components/ParentsHub.tsx b/mobile/src/components/ParentsHub.tsx
index 64f1e9b..ae2e149 100644
--- a/mobile/src/components/ParentsHub.tsx
+++ b/mobile/src/components/ParentsHub.tsx
@@ -28,6 +28,7 @@ type Props = {
   onOpenTranscript: (student: Student) => void;
   onOpenPaywall: () => void;
   onRequestLogout: () => void;
+  billingVersion?: number;
 };
 
 export default function ParentsHub({
@@ -38,6 +39,7 @@ export default function ParentsHub({
   onOpenTranscript,
   onOpenPaywall,
   onRequestLogout,
+  billingVersion = 0,
 }: Props) {
   // Add child state
   const [newChildName, setNewChildName] = useState('');
@@ -57,7 +59,7 @@ export default function ParentsHub({
       const premium = await isPremiumActive();
       setIsPremium(premium);
     })();
-  }, []);
+  }, [billingVersion]);
 
   const fetchMemory = async (studentId: string) => {
     setLoadingMemory(true);
diff --git a/mobile/src/screens/MainShellScreen.tsx b/mobile/src/screens/MainShellScreen.tsx
index 8c0932b..140f751 100644
--- a/mobile/src/screens/MainShellScreen.tsx
+++ b/mobile/src/screens/MainShellScreen.tsx
@@ -27,6 +27,7 @@ type Props = {
   onOpenTranscript: (student: Student) => void;
   onStartCall: (student: Student) => void;
   onLimitReached: () => void;
+  billingVersion?: number;
 };
 
 export default function MainShellScreen({
@@ -35,6 +36,7 @@ export default function MainShellScreen({
   onOpenTranscript,
   onStartCall,
   onLimitReached,
+  billingVersion = 0,
 }: Props) {
   const [tab, setTab] = useState<TabKey>('chat');
   const [isPremium, setIsPremium] = useState(false);
@@ -88,6 +90,12 @@ export default function MainShellScreen({
     loadStudentList();
   }, []);
 
+  // Re-check the plan after a purchase (the shell stays mounted behind the paywall)
+  useEffect(() => {
+    if (billingVersion === 0) return;
+    isPremiumActive().then(setIsPremium).catch(() => {});
+  }, [billingVersion]);
+
   // Handle hardware back on Android: return to 'chat' tab before exiting
   useEffect(() => {
     const onBackPress = () => {
@@ -289,6 +297,7 @@ export default function MainShellScreen({
                   onOpenTranscript={onOpenTranscript}
                   onOpenPaywall={onOpenPaywall}
                   onRequestLogout={() => setLogoutGateVisible(true)}
+                  billingVersion={billingVersion}
                 />
 
                 {/* Logout Parental Gate */}
