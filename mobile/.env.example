# Mobile API backend URL
# Android Emulator: http://10.0.2.2:3003 (default host loopback alias)
# Physical Device on LAN: http://<PC_LOCAL_IP>:3003
EXPO_PUBLIC_API_URL=http://10.0.2.2:3003

# RevenueCat Mobile API Key (from RevenueCat Dashboard -> Project Settings -> API Keys)
EXPO_PUBLIC_REVENUECAT_API_KEY=
